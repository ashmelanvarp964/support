# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Defaults to 3000 in cloud sandbox; 48044 configurable for custom hosting)
PORT=3000

# Session & Security
SESSION_SECRET="lumacloud-super-secure-secret-key-change-in-prod"
DISCORD_WEBHOOK_ENCRYPTION_KEY="lumacloud-webhook-crypto-key"

# Permanent System Owner Account
OWNER_EMAIL="support@lumacloud.xyz"
OWNER_PASSWORD=""

# Google OAuth (Optional - One-click Google sign-in works in demo/popup or via client id)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP Email System Configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="STARTTLS"
SMTP_FROM_NAME="LumaCloud Support"
SMTP_FROM_EMAIL="support@lumacloud.xyz"
SMTP_REPLY_TO="support@lumacloud.xyz"

# Upload Limits
UPLOAD_MAX_SIZE=10485760

